# VeloxScreen example configuration
# Copy to: ~/printer_data/config/veloxscreen.conf
# Values are examples. Check your printer's supported limits before using commands.

[connection]
moonraker_url = http://127.0.0.1:7125
refresh_ms = 1000

[appearance]
title = VeloxScreen
font_size = 15
language = en
accent_color = #2866bd
overlay_color = #171f2d
background_color = #0c1119
sidebar_color = #111925
button_color = #26364e

[extrusion]
lengths = 1, 5, 10, 50, 100
speeds = 2, 5, 10, 20, 50
jog_steps = 1, 5, 15, 25, 50

[jog]
# Affects only the manual X/Y/Z movement buttons in VeloxScreen.
# No effect on homing, print moves or Klipper stepper direction.
invert_x = false
invert_y = false
invert_z = false
speed_x = 100
speed_y = 100
speed_z = 10

[tools]
# Empty means automatic extrusion-object discovery.
# Optional tool-to-extruder mappings (adjust to your machine):
# T0 = extruder
# T1 = extruder1

[temperature_presets]
PLA = nozzle:210, bed:60
PETG = nozzle:240, bed:80
ABS = nozzle:250, bed:100
# Optional single-heater presets:
# Bed 60 = bed:60
# Chamber 45 = chamber:45

[macros]
# Optional custom macro shortcuts. Klipper macros are also discovered automatically.
# Nozzle brush = BRUSH_NOZZLE

[layout]
# Fan objects are automatically detected. Optional explicit ordering:
# fan_order = fan, fan_generic aux
# Use Settings > Customize layout to edit these orders (empty = defaults).
# print_order = ["temperatures", "fans", "motion", "overrides"]
# dashboard_order = ["temperatures", "motion", "overrides", "print_status", "presets", "motion_limits", "homing"]
# temperature_order = ["heater_bed", "extruder", "extruder1"]
# nav_order, control_order, tools_order, temperatures_order, macros_order,
# settings_order, macro_order and preset_order are also supported.
# chamber_heater = heater_generic chamber_heater

[behavior]
# Turning this off sends commands without an extra confirmation dialog.
confirm_commands = true
# Separate confirmation for the Settings host shutdown button.
confirm_shutdown = true

[macro_visibility]
# 'all': show all except names listed under hidden.
# 'selected': show only names listed under visible, including newly added macros.
mode = all
visible =
hidden =

[led_effects]
fade_seconds = 0.5

[startup]
show_splash = true
animate_speedlines = true
duration_seconds = 3
# Optional custom splash image, absolute or relative to printer_data/config.
image =

[notifications]
enabled = true
duration_seconds = 4
# Local history (up to 150 entries); turn off to delete persisted history.
persist_history = true
popup_print = true
popup_heating = true
popup_filament = true
popup_warning = true
popup_printer = true
popup_g_code = true

[overrides]
# M220 speed and M221 flow limits in percent; UI step sizes are fixed.
speed_min = 10
speed_max = 300
flow_min = 50
flow_max = 150

[display]
# Auto adjusts columns, navigation and font sizes to the detected screen resolution.
# Examples: 320x240, 480x320, 800x480, 1024x600.
# Seven-inch and five-inch screens with the same pixel resolution look identical to Qt.
# Optional manual magnification: 0.7 to 1.5 (e.g. 1.15 for a 7-inch screen).
ui_scale = auto
# Seconds of inactivity. 0 disables the respective timer.
dim_after = 120
off_after = 300
keep_on_print = true
# Optional physical backlight / X11 DPMS. Otherwise uses a software overlay.
hardware_idle = false
# Optional hardware brightness percent: 5..100 (only if driver permits it).
# brightness = 80
font_scale = 1
button_scale = 1
start_page = Dashboard
# dot (default), hidden, system. Restart VeloxScreen to apply.
cursor_style = dot

[quick_actions]
enabled = true
# IDs are kept stable across languages. Choose and reorder in Settings.
items = ["page:Dashboard", "page:Temperaturen", "page:Print", "page:Notifications"]

[print_view]
# Switch to the print page once when Klipper reports a new active print.
# Users can still navigate away while printing.
auto_open = true

# Optional single-material density in g/cm³; 0 = show length only.
filament_density = 0

# Optional: choose scan or tap ONLY after verifying your installed Eddy firmware
# and actual Z calibration procedure. Empty = permanent Eddy save disabled.
[babystep]
eddy_method =
